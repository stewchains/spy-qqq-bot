# Copy this file to ".env" and paste your keys. Never share this file.
# Paper keys: Alpaca dashboard -> switch to Paper account -> "API Keys" -> Generate.
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here

# Optional: lets Claude read the news headlines (set news.use_claude: true in config.yaml)
ANTHROPIC_API_KEY=

# Second paper account for the 30-45 day bot (config_swing.yaml has alpaca_keys: SWING)
ALPACA_API_KEY_SWING=
ALPACA_SECRET_KEY_SWING=
