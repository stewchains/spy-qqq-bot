# Copy this file to ".env" and paste your keys. Never share this file.
# Paper keys: Alpaca dashboard -> switch to Paper account -> "API Keys" -> Generate.
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here

# Optional: lets Claude read the news headlines (set news.use_claude: true in config.yaml)
ANTHROPIC_API_KEY=

# Second paper account for the 30-45 day bot (config_swing.yaml has alpaca_keys: SWING)
ALPACA_API_KEY_SWING=
ALPACA_SECRET_KEY_SWING=

# Daily report -> Discord. Discord: Server Settings -> Integrations -> Webhooks -> New Webhook,
# pick the channel, Copy Webhook URL, paste below. Both bots post here.
DISCORD_WEBHOOK_URL=
# Optional: send the 30-45 day bot's report to a different channel
DISCORD_WEBHOOK_URL_SWING=

# Optional outbound AI City telemetry. Leave both blank to disable it.
# Use the HTTPS URL of your deployed Local Fitted City service, without a trailing slash.
AI_CITY_TELEMETRY_URL=
# Must match LOCALFITTED_ADMIN_TOKEN on the Local Fitted City service. Keep private.
AI_CITY_TELEMETRY_TOKEN=
# Optional request timeout in seconds (bounded by the client to 0.5-3 seconds).
AI_CITY_TELEMETRY_TIMEOUT=1.0
